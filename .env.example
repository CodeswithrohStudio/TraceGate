# SigNoz / OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=tracegate-demo-agent
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local,service.namespace=tracegate

# Optional: real provider mode. The deterministic demo does not need this.
OPENAI_API_KEY=

# Optional: SigNoz API/MCP values for later live dashboard and alert writes.
SIGNOZ_API_BASE_URL=http://localhost:8080
SIGNOZ_API_KEY=
SIGNOZ_MCP_URL=http://localhost:8000/mcp
